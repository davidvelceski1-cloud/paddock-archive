# Ask the Archive, AI summaries and natural-language filters (optional). Without a key
# every AI feature falls back to a deterministic offline mode that is still grounded and cited.
ANTHROPIC_API_KEY=

# PostgreSQL + pgvector (optional for running the site; required for `npm run db:push` / `db:seed`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paddock

# Public site URL, used for Open Graph images, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
